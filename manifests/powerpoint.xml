<?xml version="1.0" encoding="UTF-8"?>
<!--
  JVision for PowerPoint — 任務窗格增益集。

  與 manifests/excel.xml、word.xml 同一個範本，只差在 <Id>、主應用程式名稱與文案。
  三份 manifest 都指向同一個 taskpane.html，Office.onReady 自己判斷在哪——
  為什麼不合成一份，見 docs/multi-host.md。

  ── SharedRuntime 是必要的，不是可選的 ──
  它讓任務窗格跑在一個長生命週期的 runtime 裡，關掉窗格再打開不會把對話狀態清空。
  代價是硬性排除了 PowerPoint 2016/2019 買斷版、iPad、Android。

  ── 這份為什麼只要求 SharedRuntime，不要求 PowerPointApi ──
  刻意的。<Requirements> 沒過的話，增益集在「我的增益集」清單裡**根本不會出現**，
  使用者連為什麼裝不起來都看不到。而這個增益集在不同 Office 版本上能做的事是漸進的：

    PowerPointApi 1.3  新增／刪除投影片
    PowerPointApi 1.4  文字方塊、圖形、線條、排版對齊 ← 絕大部分功能在這裡
    PowerPointApi 1.6  讀取選取的投影片、跳到某一張
    ImageCoercion 1.1  插入圖片（Office 2021 以上）
    ImageCoercion 1.2  插入 SVG 向量圖表
    PowerPointApi 1.8  表格（要 Office 2504 以上，大量授權永久版沒有）

  所以版本檢查放在執行期（hosts/powerpoint.js 的 hasApi），不放在 manifest：
  舊版本的人裝得起來、看得到窗格、能用做得到的部分，做不到的部分會拿到一句說明
  「這需要 PowerPointApi 1.4」，而不是一個查不出原因的空清單。

  ── 開發 vs 正式 ──
  下面的網址指向開發用的本機伺服器（localhost 的 3443 埠）。正式部署時不要手改這個
  檔案 —— 執行 installer\install.ps1 -TaskpaneUrl https://你的主機，安裝程式會在複製
  時就把網址換掉，所以同一份 manifest 可以裝到任何環境。
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <!-- 換一份部署（例如正式站）就換一個 Id，否則兩份會互相覆蓋 -->
  <Id>9d2b4e17-6c83-4f52-ae10-7b93c8d5e204</Id>
  <Version>1.0.49.0</Version>
  <ProviderName>PANJIT</ProviderName>
  <DefaultLocale>zh-TW</DefaultLocale>
  <DisplayName DefaultValue="JVision for PowerPoint" />
  <Description DefaultValue="在 PowerPoint 側邊欄直接問 AI：做投影片、排版對齊、統一配色、畫流程圖。它讀得到每個物件的座標。" />
  <IconUrl DefaultValue="https://localhost:3443/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3443/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://localhost:3443/" />

  <!-- 任務窗格可以導覽到的網域。API 的跨來源請求走 CORS，不受這裡管。 -->
  <AppDomains>
    <AppDomain>https://localhost:3443</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Presentation" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="SharedRuntime" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3443/src/taskpane/taskpane.html" />
  </DefaultSettings>

  <!-- 讀寫整份簡報。少於這個等級就改不了投影片。 -->
  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Presentation">
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long" />
        </Runtimes>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Taskpane.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="JVisionGroup">
                <Label resid="JVisionGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="JVisionTaskpaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>JVisionTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:3443/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3443/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3443/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3443/src/taskpane/taskpane.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://localhost:3443/" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="JVisionGroup.Label" DefaultValue="JVision" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="JVision" />
        <bt:String id="GetStarted.Title" DefaultValue="JVision for PowerPoint 已安裝" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="開啟 JVision 側邊欄，直接對目前這份簡報提問。" />
        <bt:String id="GetStarted.Description" DefaultValue="在「常用」分頁點一下 JVision 助手，登入後就能對目前開啟的簡報提問，或請它幫你排版。" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
