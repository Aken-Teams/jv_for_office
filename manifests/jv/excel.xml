<?xml version="1.0" encoding="UTF-8"?>
<!--
  JVision for Excel — 任務窗格增益集。

  設計取自 Claude for Excel 的 manifest（TaskPaneApp + SharedRuntime +
  ReadWriteDocument + Home 分頁一顆按鈕），差別只在 SourceLocation 指向我們自己的
  主機，而不是 pivot.claude.ai。

  ── SharedRuntime 是必要的，不是可選的 ──
  它讓任務窗格跑在一個長生命週期的 runtime 裡，關掉窗格再打開不會把對話狀態清空。
  代價是硬性排除了 Excel 2016/2019 買斷版、iPad、Android，以及低於
  16.0.13127.20296 的 Microsoft 365 組建 —— Claude for Excel 的支援版本清單就是
  這麼來的。部署前務必先確認公司實際的 Office 組建分布。

  ── 開發 vs 正式 ──
  下面的網址指向開發用的本機伺服器（localhost 的 3443 埠）。正式部署時不要手改這個
  檔案 —— 執行 installer\install.ps1 -TaskpaneUrl https://你的主機，安裝程式會在複製
  時就把網址換掉，所以同一份 manifest 可以裝到任何環境。
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <!-- 換一份部署（例如正式站）就換一個 Id，否則兩份會互相覆蓋 -->
  <Id>e939e9c7-1c4f-48da-bd31-72c756d08027</Id>
  <Version>1.0.49.0</Version>
  <ProviderName>PANJIT</ProviderName>
  <DefaultLocale>zh-TW</DefaultLocale>
  <DisplayName DefaultValue="【JV】JVision for Excel" />
  <Description DefaultValue="【JV版本，請勿用於正式文件】在 Excel 側邊欄直接問 AI：讀懂公式、追溯假設、修正錯誤、填寫模型。" />
  <IconUrl DefaultValue="https://jvision.theaken.com/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://jvision.theaken.com/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://jvision.theaken.com/" />

  <!-- 任務窗格可以導覽到的網域。API 的跨來源請求走 CORS，不受這裡管。

       accounts.google.com 是給 Google 登入用的：那條流程會開一個 Office 對話框，
       而對話框導到這裡沒有列出的網域時，Office 會直接拒絕開啟——而且不會說為什麼，
       只會回一個通用的錯誤碼。漏了這一行的症狀是「按了 Google 登入沒反應」。

       只是允許導覽，不等於信任：回傳的 id_token 仍然由伺服器驗簽章和 audience。 -->
  <AppDomains>
    <AppDomain>https://jvision.theaken.com</AppDomain>
    <AppDomain>https://accounts.google.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="SharedRuntime" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://jvision.theaken.com/src/taskpane/taskpane.html" />
  </DefaultSettings>

  <!-- 讀寫整份活頁簿。少於這個等級就寫不進儲存格。 -->
  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long" />
        </Runtimes>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Taskpane.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="JVisionGroup">
                <Label resid="JVisionGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="JVisionTaskpaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>JVisionTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://jvision.theaken.com/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://jvision.theaken.com/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://jvision.theaken.com/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://jvision.theaken.com/src/taskpane/taskpane.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://jvision.theaken.com/" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="JVisionGroup.Label" DefaultValue="JVision·J" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="JVision·J" />
        <bt:String id="GetStarted.Title" DefaultValue="【JV】JVision for Excel 已安裝" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="【JV版本】開啟 JVision 側邊欄，直接對目前這份活頁簿提問。" />
        <bt:String id="GetStarted.Description" DefaultValue="在「常用」分頁點一下 JVision 助手，登入後就能對目前開啟的活頁簿提問。" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
